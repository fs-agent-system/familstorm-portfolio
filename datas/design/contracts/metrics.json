{
  "id": "metrics",
  "name": "Velocity & Quality Metrics Section Contract",
  "screen_id": "FS-WEB-01",
  "version": "1.0",
  "purpose": "Demonstrate quantifiable business velocity and quality assurance advantages over traditional offshore dev.",
  "tokens": {
    "background": "brand.background",
